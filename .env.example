# Copia este archivo como .env.local y rellena los valores.
# .env.local está en .gitignore: nunca subas tus claves a GitHub.

# URL pública de la web (para metadatos, sitemap y robots).
# En Vercel no hace falta hasta que conectes tu dominio propio.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# --- Chatbot (todavía no se usa) ---------------------------------
# Elige un proveedor. En Vercel se añaden en Settings → Environment Variables.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Límite de uso por IP (Upstash Redis, opcional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
