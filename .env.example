# Copia este archivo como .env.local y rellena los valores.
# .env.local está en .gitignore: nunca subas tus claves a GitHub.
# En Vercel se añaden en Settings → Environment Variables.

# URL pública de la web (para metadatos, sitemap y robots).
# En Vercel no hace falta hasta que conectes tu dominio propio.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# --- Chatbot ------------------------------------------------------
# Rellena UNA de las dos claves. Si están las dos, se usa OpenRouter.
# Sin ninguna, el chat muestra "Próximamente".
# openrouter.ai → Keys
OPENROUTER_API_KEY=
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Modelo (opcional). Por defecto Claude Opus 5.5:
#   OpenRouter: anthropic/claude-opus-5.5 · anthropic/claude-sonnet-5.5 · anthropic/claude-haiku-5.5
#   Anthropic:  claude-opus-5-5 · claude-sonnet-5-5 · claude-haiku-5-5
CHAT_MODEL=

# Límite de uso compartido entre instancias (Upstash Redis).
# Opcional en local; muy recomendable antes de publicar el chat.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
